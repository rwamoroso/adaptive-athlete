# Copy to scripts/supabase_db.env (gitignored) and fill with your Supabase DB connection.
#
# Preferred (Supabase pooled connection):
#   Supabase Dashboard -> Project Settings -> Database -> Connection string
#   Use the "Session pooler" / "Pooler" URI and include sslmode=require.
#
# Example format:
# SUPABASE_DB_URL=postgresql://postgres.<project-ref>:YOUR_PASSWORD@aws-1-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require

SUPABASE_DB_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-1-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
